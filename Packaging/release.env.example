# Copy to Packaging/release.env (git-ignored) and fill in. Nothing here is secret:
# the Sparkle private key stays in your login keychain and the notary password in a
# notarytool keychain profile.

# HTTPS URL of the Sparkle appcast, e.g. https://example.com/lampo/appcast.xml
LAMPO_FEED_URL=""
# Where the release zips are downloaded from (the appcast and the cask point here),
# e.g. https://github.com/<you>/lampo/releases/download — the script appends /v<version>/<file>.
LAMPO_DOWNLOAD_URL_PREFIX=""
# Output of `generate_keys -p` (Sparkle EdDSA public key).
LAMPO_SPARKLE_PUBLIC_KEY=""
# Shown in Settings › About (optional).
LAMPO_WEBSITE_URL=""
LAMPO_REPOSITORY_URL=""
# Name of the profile created with `xcrun notarytool store-credentials`.
NOTARY_PROFILE="lampo-notary"
