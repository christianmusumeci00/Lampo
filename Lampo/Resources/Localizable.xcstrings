      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finestra: %@"
          }
        }
      }
    },
    "Without selected text there's nothing to replace: the result opens in the panel.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza testo selezionato non c'è niente da sostituire: il risultato si apre nel pannello."
          }
        }
      }
    },
    "Works in every app, including full-screen ones.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona in tutte le app, anche a tutto schermo."
          }
        }
      }
    },
    "Write instructions in English for the best results. {{selection}} is the selected text, {{text_language}} its language, {{language}} your answer language.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi le istruzioni in inglese per risultati migliori. {{selection}} è il testo selezionato, {{text_language}} la sua lingua, {{language}} la lingua delle risposte."
          }
        }
      }
    },
    "Writing…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sto scrivendo…"
          }
        }
      }
    },
    "You can change this later in Lampo Settings › Privacy.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiarlo in seguito in Impostazioni di Lampo › Privacy."
          }
        }
      }
    },
    "You reached the Private Cloud Compute limit for now. Try again later.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di Private Cloud Compute per ora. Riprova più tardi."
          }
        }
      }
    },
    "Your Mac's intelligence, one shortcut away.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intelligenza del tuo Mac, a una scorciatoia di distanza."
          }
        }
      }
    },
    "Your questions and Lampo's answers are saved only on this Mac, for up to %lld requests. Turning history off deletes it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue domande e le risposte di Lampo restano solo su questo Mac, fino a %lld richieste. Disattivando la cronologia la elimini."
          }
        }
      }
    },
