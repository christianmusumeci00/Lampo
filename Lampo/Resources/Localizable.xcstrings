      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione %@"
          }
        }
      }
    },
    "When on, Lampo never uses Private Cloud Compute: every request is answered by the model on your Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivo, Lampo non usa mai Private Cloud Compute: ogni richiesta viene elaborata dal modello sul tuo Mac."
          }
        }
      }
    },
    "Works in every app, including full-screen ones.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona in tutte le app, anche a tutto schermo."
          }
        }
      }
    },
    "You reached the Private Cloud Compute limit for now. Try again later.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il limite di Private Cloud Compute per ora. Riprova più tardi."
          }
        }
      }
    },
    "Your Mac's intelligence, one shortcut away.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’intelligenza del tuo Mac, a una scorciatoia di distanza."
          }
