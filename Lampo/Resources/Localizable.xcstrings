          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to use Lampo.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence nelle Impostazioni di Sistema per usare Lampo."
