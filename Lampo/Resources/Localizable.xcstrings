          "stringUnit": {
            "state": "translated",
            "value": "Versione %@"
          }
        }
      }
    },
    "What should I remind you? e.g. call Anna tomorrow at 10": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa devo ricordarti? es. chiamare Anna domani alle 10"
          }
