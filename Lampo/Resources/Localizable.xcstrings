    },
    "This Mac doesn't support Apple Intelligence.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac non supporta Apple Intelligence."
          }
        }
      }
    },
    "This deletes every saved request and answer. It can't be undone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutte le richieste e le risposte salvate. L'operazione non si può annullare."
