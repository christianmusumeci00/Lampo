    },
    "hi Marta, i cant come tomorow to the meeting becuase i have a dentist appointment, can we move it to friday?": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ciao Marta, domani non riesco a venire alla riunione perche ho il dentista, possiamo spostarla a venerdi?"
