    },
    "“Only on this Mac” is on, so Lampo won't use Private Cloud Compute.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Solo sul Mac” è attivo, quindi Lampo non userà Private Cloud Compute."
          }
        }
      }
    },
    "“Only on this Mac” is on: this action runs on your Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Solo sul Mac” è attivo: questa azione viene eseguita sul tuo Mac."
          }
        }
      }
    },
    "⌥Space for Lampo, ⌥⇧ and a letter for the built-in actions. Custom actions lose their shortcut.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥Spazio per Lampo, ⌥⇧ e una lettera per le azioni predefinite. Le azioni personalizzate perdono la scorciatoia."
          }
        }
      }
    }
