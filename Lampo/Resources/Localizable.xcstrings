      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto"
          }
        }
      }
    },
    "The model declined to answer this request.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello ha rifiutato di rispondere a questa richiesta."
          }
        }
      }
    },
    "The model does not support this language yet.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non supporta ancora questa lingua."
          }
        }
      }
    },
    "The model is busy right now. Try again in a moment.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è occupato. Riprova tra un momento."
          }
        }
      }
    },
    "The model is still downloading. Lampo will be ready shortly.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello è ancora in download. Lampo sarà pronto a breve."
          }
        }
      }
    },
    "The model on this Mac is ready.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sul Mac è pronto."
          }
        }
      }
    },
    "The model returned an empty answer. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello ha restituito una risposta vuota. Riprova."
          }
        }
      }
    },
    "The model took too long to answer. Try again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello ha impiegato troppo tempo. Riprova."
          }
        }
      }
    },
    "The on-device model is not available.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sul Mac non è disponibile."
          }
        }
      }
    },
    "The text is too long for the on-device model. Try a shorter selection.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo è troppo lungo per il modello sul Mac. Prova con una selezione più breve."
